{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "DAPLink Debug",
            "cwd": "${workspaceFolder}",
            // OUTPUT_NAME is `system`, so the executable is system.elf.
            "executable": "${workspaceFolder}/build/Release/system.elf",
            "request": "launch",
            "type": "cortex-debug",
            "svdFile": "${workspaceFolder}/STM32F407.svd",
            "servertype": "openocd",
            // Host tool locations: Linux base values, Windows overrides below.
            "serverpath": "/usr/bin/openocd",
            "gdbPath": "/usr/bin/arm-none-eabi-gdb",
            "armToolchainPath": "/usr/bin",
            "windows": {
                "serverpath": "C:\\ProgramData\\chocolatey\\lib\\openocd\\tools\\install\\bin\\openocd.exe",
                "gdbPath": "C:\\ProgramData\\chocolatey\\lib\\gcc-arm-embedded\\tools\\gcc-arm-none-eabi-10.3-2021.10\\bin\\arm-none-eabi-gdb.exe",
                "armToolchainPath": "C:\\ProgramData\\chocolatey\\bin"
            },
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/stm32f4x.cfg"
            ],
            "runToEntryPoint": "main", // 停在 main 入口
            "postLaunchCommands": [ // 启动后自动执行的命令
                "continue" // 自动继续运行
            ],
            // Must match a label in tasks.json.
            "preLaunchTask": "Build All",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            }
        }
    ]
}
