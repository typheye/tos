{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cmake configure",
      "detail": "Run CMake configure step. Required once after checkout or build dir cleanup.",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-B",
        "${workspaceFolder}/build/Release",
        "-DCMAKE_BUILD_TYPE=Release"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Build & Flash (factory)",
      "detail": "Build ALL partitions, sign them, then flash the complete boot chain (ELF+SBL+TEE+REC+SAH+SYSTEM) via OpenOCD.",
      "type": "shell",
      "icon": {
        "id": "play",
        "tooltip": "Build, sign, and flash all partitions"
      },
      "command": "${workspaceFolder}/scripts/upload_factory.bat",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "OPENOCD_SPEED": "16000"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Flash (system)",
      "detail": "Flash only SYSTEM partition. SBL/REC/ELF unchanged.",
      "type": "shell",
      "icon": {
        "id": "play",
        "tooltip": "Flash system partitions"
      },
      "command": "${workspaceFolder}/scripts/upload.bat",
      "args": [
        "system"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "OPENOCD_SPEED": "16000"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Flash (runtime)",
      "detail": "Flash REC + SAH + SYSTEM. ELF/SBL/TEE unchanged.",
      "type": "shell",
      "icon": {
        "id": "play",
        "tooltip": "Flash rec/sah/system partitions"
      },
      "command": "${workspaceFolder}/scripts/upload.bat",
      "args": [
        "runtime"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "OPENOCD_SPEED": "16000"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Build (factory images only)",
      "detail": "Build and sign all partitions, output to dist/. Does NOT flash.",
      "type": "shell",
      "icon": {
        "id": "build",
        "tooltip": "Build all partitions"
      },
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build/Release",
        "--target",
        "factory_images",
        "-j",
        "24"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Clean",
      "detail": "Remove build artifacts.",
      "type": "shell",
      "icon": {
        "id": "trash",
        "tooltip": "Clean the project"
      },
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build/Release",
        "--target",
        "clean"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}