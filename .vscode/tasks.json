{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build factory images",
      "type": "shell",
      "icon": {
        "id": "play",
        "tooltip": "Tips"
      },
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build/Release",
        "--target",
        "factory_images",
        "-j",
        "24"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "build system",
      "type": "shell",
      "icon": {
        "id": "play",
        "tooltip": "Tips"
      },
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build/Release",
        "--target",
        "system",
        "-j",
        "24"
      ],
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "export partitions",
      "type": "shell",
      "icon": {
        "id": "play",
        "tooltip": "Tips"
      },
      "command": "${workspaceFolder}/scripts/export_partitions.bat",
      "args": [
        "-BuildDir",
        "${workspaceFolder}/build/Release"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "flash system",
      "type": "shell",
      "icon": {
        "id": "play",
        "tooltip": "Tips"
      },
      "command": "${workspaceFolder}/scripts/upload.bat",
      "args": [
        "system"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "flash runtime",
      "type": "shell",
      "icon": {
        "id": "play",
        "tooltip": "Tips"
      },
      "command": "${workspaceFolder}/scripts/upload.bat",
      "args": [
        "runtime"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "flash factory",
      "type": "shell",
      "icon": {
        "id": "play",
        "tooltip": "Tips"
      },
      "command": "${workspaceFolder}/scripts/upload.bat",
      "args": [
        "factory"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "clean",
      "type": "shell",
      "icon": {
        "id": "play",
        "tooltip": "Tips"
      },
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build/Release",
        "--target",
        "clean"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}